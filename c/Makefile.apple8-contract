CC ?= cc
CFLAGS ?= -O2 -std=c11 -Wall -Wextra -Werror
EXE :=
ifeq ($(OS),Windows_NT)
EXE := .exe
endif

.PHONY: check check-registry clean

check: test_apple8_contract$(EXE) tests/test_apple8_package$(EXE) tests/test_apple8_executor_contract$(EXE)
	./test_apple8_contract$(EXE)
	./tests/test_apple8_package$(EXE)
	./tests/test_apple8_executor_contract$(EXE)

check-registry:
	python3 ../tools/gen_target_registry.py --check

test_apple8_contract$(EXE): tests/test_apple8_contract.c apple8_contract.h generated/coli_target_registry.h expert_representation.h coli_format.h
	$(CC) $(CFLAGS) tests/test_apple8_contract.c -o $@

tests/test_apple8_package$(EXE): tests/test_apple8_package.c coli_format.c coli_format_base.c coli_format.h apple8_contract.h generated/coli_target_registry.h compat.h
	$(CC) $(CFLAGS) tests/test_apple8_package.c coli_format.c -o $@ -pthread

tests/test_apple8_executor_contract$(EXE): tests/test_apple8_executor_contract.c coli_executor.c coli_executor.h coli_format.c coli_format_base.c coli_format.h apple8_contract.h generated/coli_target_registry.h compat.h
	$(CC) $(CFLAGS) tests/test_apple8_executor_contract.c coli_executor.c coli_format.c -o $@ -pthread

clean:
	rm -f test_apple8_contract test_apple8_contract.exe \
		tests/test_apple8_package tests/test_apple8_package.exe \
		tests/test_apple8_executor_contract tests/test_apple8_executor_contract.exe
