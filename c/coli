#!/usr/bin/env python3
"""Public Colibri CLI bootstrap.

The full CLI implementation lives in tools/coli_cli.py.  Keeping this launcher
small lets package-level compatibility policy live at the public command boundary
without duplicating engine protocols or rewriting the large CLI module.
"""
import os
import signal
import sys

_PUBLIC_FILE = os.path.abspath(__file__)
_PUBLIC_DIR = os.path.dirname(_PUBLIC_FILE)
_LIBEXEC = os.path.join(os.path.dirname(_PUBLIC_DIR), "libexec", "colibri")
_candidates = (
    os.path.join(_PUBLIC_DIR, "tools", "coli_cli.py"),
    os.path.join(_LIBEXEC, "tools", "coli_cli.py"),
)
_CORE = next((p for p in _candidates if os.path.isfile(p)), None)
if _CORE is None:
    sys.exit("colibri installation is incomplete: tools/coli_cli.py is missing")

# Execute the existing CLI in this module's namespace, but do not trigger its
# __main__ block yet.  Keep __file__ pointed at the public launcher: the core's
# existing source-vs-installed path detection therefore remains correct.
with open(_CORE, "rb") as _stream:
    _code = compile(_stream.read(), _CORE, "exec")
_name = __name__
globals()["__name__"] = "coli_cli_core"
globals()["__file__"] = _PUBLIC_FILE
exec(_code, globals(), globals())
globals()["__name__"] = _name
globals()["__file__"] = _PUBLIC_FILE

# Compiled COLI packages are self-contained: config.json/tokenizer.json live
# beside manifest.coli and the data shards.  The current Qwen C loader still has
# a legacy internal COLI_CONFIG lookup from the first compiler prototype; make
# that compatibility channel package-owned and non-user-configurable.  Every
# public Qwen command therefore resolves metadata from --model itself, even if a
# stale COLI_CONFIG is present in the caller's environment.
_core_env_for_engine = env_for_engine
def env_for_engine(a, arch):
    env = _core_env_for_engine(a, arch)
    model = getattr(a, "model", None)
    if (arch == "qwen3_moe" and model and
            os.path.isfile(os.path.join(model, "manifest.coli"))):
        env["COLI_CONFIG"] = os.path.realpath(model)
    return env

if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.default_int_handler)
    main()
