# DeepSeek V4 amalgamation build — x86-64/aarch64 Linux, Windows/MSYS2, and
# arm64 macOS. (An earlier version of this header claimed GNU-ld --wrap as a
# hard dependency; nothing here has used --wrap for a while, and macOS
# portability rides compat.h: posix_fadvise -> F_RDADVISE, O_DIRECT ->
# F_NOCACHE.) The parent Makefile gates COLI_V4_SUPPORTED.

ifeq ($(OS),Windows_NT)
IS_WIN := 1
UNAME_S :=
UNAME_M :=
else
IS_WIN :=
UNAME_S := $(shell uname -s 2>/dev/null)
UNAME_M := $(shell uname -m 2>/dev/null)
endif

COLI_V4_OK :=
ifeq ($(IS_WIN),1)
COLI_V4_OK := 1
else ifeq ($(UNAME_S),Linux)
ifneq (,$(filter x86_64 amd64 aarch64 arm64,$(UNAME_M)))
COLI_V4_OK := 1
endif
else ifeq ($(UNAME_S),Darwin)
ifneq (,$(filter arm64,$(UNAME_M)))
COLI_V4_OK := 1
endif
endif

ifneq ($(COLI_V4_OK),1)
$(error Makefile.deepseek-v4 supports x86-64/aarch64 Linux, Windows/MSYS2, and arm64 macOS)
endif

# The parent Makefile's V4 unit-test link deliberately does not link the Metal
# Objective-C++ backend.  Keep those object files CPU-only even though normal
# macOS V4 engine builds default METAL=1.  Without this, native_quant.h emits
# references to coli_metal_* and `make check` fails at link time on arm64 macOS.
# A real `deepseek-v4` target still gets the default Metal path below.
ifneq (,$(filter deepseek-v4-test-objs,$(MAKECMDGOALS)))
METAL := 0
endif

ifneq ($(IS_WIN),)
CC = gcc
ARCH ?= x86-64-v3
CFLAGS = -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -O3 -march=$(ARCH) -fopenmp \
	-include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24 \
	-DCOLI_V4_EXPERIMENTAL_DUAL_EXPERT_LOADER
LDFLAGS = -lm -fopenmp -static -pthread
V4_BINARY := deepseek_v4.exe
else ifeq ($(UNAME_S),Darwin)
# Apple clang has no bundled OpenMP runtime: use Homebrew libomp when its
# artifacts are actually present, else build single-threaded (pragmas are
# ignored). No -march: NEON is baseline on arm64 and the per-feature gates in
# the sources do the rest. Mirrors the parent Makefile's Darwin block.
CC = clang
OMPDIR := $(shell brew --prefix libomp 2>/dev/null)
ifneq ($(and $(OMPDIR),$(wildcard $(OMPDIR)/include/omp.h),$(wildcard $(OMPDIR)/lib/libomp.*)),)
OMPC = -Xclang -fopenmp -I$(OMPDIR)/include
OMPL = -L$(OMPDIR)/lib -lomp
else
$(warning libomp not found: building deepseek_v4 single-threaded. brew install libomp)
OMPC =
OMPL =
endif
CFLAGS = -D_GNU_SOURCE -O3 $(OMPC) -pthread -include pthread.h \
	-Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24 \
	-DCOLI_V4_EXPERIMENTAL_DUAL_EXPERT_LOADER
LDFLAGS = -lm $(OMPL) -pthread
V4_BINARY := deepseek_v4
# METAL=1 enables the Apple-GPU MXFP4 expert path on Darwin (default ON —
# shader compiles at runtime, no Xcode/offline metal compiler needed; CPU is
# always the fallback). V4_METAL_EXPERTS=0 opts out at runtime.
METAL ?= 1
V4_METAL_OBJS =
ifeq ($(METAL),1)
METALXX = clang++ -x objective-c++ -std=gnu++17 -fobjc-arc -O3
V4_METAL_OBJS = backend_metal.o
CFLAGS += -DCOLI_METAL
LDFLAGS += -framework Metal -framework Foundation -lc++
$(V4_METAL_OBJS): backend_metal.mm backend_metal.h
	$(METALXX) -c backend_metal.mm -o $@
endif
else
CC = gcc
ARCH ?= native
CFLAGS = -D_GNU_SOURCE -O3 -march=$(ARCH) -fopenmp -pthread -include pthread.h \
	-Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24 \
	-DCOLI_V4_EXPERIMENTAL_DUAL_EXPERT_LOADER
LDFLAGS = -lm -fopenmp -pthread
V4_BINARY := deepseek_v4
endif

# Stamp the binary with the source revision used for the build. This is
# intentionally part of CFLAGS so .deepseek-v4-build-config invalidates stale
# objects after a branch switch / pull. Source archives without .git remain
# buildable and report "unknown".
V4_GIT_SHA := $(shell git rev-parse --short=12 HEAD 2>/dev/null || printf unknown)
CFLAGS += -DCOLI_V4_GIT_SHA='"$(V4_GIT_SHA)"'

LTO ?= 1
ifeq ($(LTO),1)
CFLAGS += -flto
LDFLAGS += -flto
endif

include Makefile.deepseek-v4.units

# Package-only dense residency borrows immutable cache pointers. The public V4
# layer API still uses the legacy `free(each payload)` cleanup contract, so only
# the layer-resident amalgamation unit routes free() through a cache-aware
# release shim. All other units keep normal libc free semantics. Keep this in
# the build-config stamp so branch switches cannot reuse a stale layer object.
V4_LAYER_RESIDENT_CFLAGS := -Dfree=coli_v4_layer_payload_free
COLI_V4_UNIT_LAYER_RESIDENT.o: CFLAGS += $(V4_LAYER_RESIDENT_CFLAGS)

TARGET_OBJS = $(addsuffix .o,$(V4_TARGET_UNITS))
TEST_UNIT_OBJS = $(addsuffix .o,$(V4_TEST_UNITS))
# #3's resource planner and startup residency allocator are now normal source
# files rather than amalgamated units. Keep their object/symbol names unchanged
# so runtime and unit-test link contracts remain identical while the planner can
# evolve independently.
V4_SPLIT_OBJS = COLI_V4_UNIT_RESOURCE_PLAN.o COLI_V4_UNIT_EXPERT_STORE_AUTO.o
V4_AMALGAMATED_OBJS = $(filter-out $(V4_SPLIT_OBJS),$(sort $(TARGET_OBJS) $(TEST_UNIT_OBJS)))
V4_COLI_OBJS = coli_v4_expert_store.o coli_v4_static.o coli_executor.o coli_format.o
V4_OBJS = $(TARGET_OBJS) $(V4_COLI_OBJS) $(V4_METAL_OBJS)
V4_BUILD_CONFIG = .deepseek-v4-build-config

.PHONY: deepseek-v4 deepseek-v4-clean deepseek-v4-test-objs FORCE
FORCE:

# C/Objective-C++ objects share names across METAL=0 and METAL=1 builds.  Make
# does not otherwise see a changed command line, so a CPU-only build could be
# accidentally reused by a later default Metal build.  Track the effective
# configuration and make every V4 object depend on it.
$(V4_BUILD_CONFIG): FORCE
	@printf '%s\n' 'CC=$(CC)' 'CFLAGS=$(CFLAGS)' 'LDFLAGS=$(LDFLAGS)' 'METAL=$(METAL)' 'LTO=$(LTO)' 'V4_LAYER_RESIDENT_CFLAGS=$(V4_LAYER_RESIDENT_CFLAGS)' > $@.tmp
	@if test -f $@ && cmp -s $@.tmp $@; then rm -f $@.tmp; else mv -f $@.tmp $@; fi

$(V4_OBJS) $(TEST_UNIT_OBJS): $(V4_BUILD_CONFIG)

deepseek-v4: $(V4_BINARY)

coli_v4_expert_store.o: coli_v4_expert_store.c coli_v4_expert_store.h coli_v4_residency.h coli_executor.h coli_format.h expert_store.h tensor.h compat.h
	$(CC) $(CFLAGS) -c coli_v4_expert_store.c -o $@
coli_v4_static.o: coli_v4_static.c coli_v4_static.h coli_v4_residency.h coli_executor.h coli_format.h deepseek_v4_internal.h
	$(CC) $(CFLAGS) -c coli_v4_static.c -o $@
coli_executor.o: coli_executor.c coli_executor.h coli_format.h
	$(CC) $(CFLAGS) -c coli_executor.c -o $@
coli_format.o: coli_format.c coli_format.h compat.h coli_v4_macos_uncached_io.h
	$(CC) $(CFLAGS) -include coli_v4_macos_uncached_io.h -c coli_format.c -o $@

# Split out of deepseek_v4.c so #3 can change planner semantics without a
# whole-amalgamation rewrite. These sources export the exact same symbols as the
# old COLI_V4_UNIT_* sections.
COLI_V4_UNIT_RESOURCE_PLAN.o: coli_v4_resource_plan.c deepseek_v4_internal.h coli_v4_residency.h
	$(CC) $(CFLAGS) -c coli_v4_resource_plan.c -o $@
COLI_V4_UNIT_EXPERT_STORE_AUTO.o: coli_v4_expert_store_auto.c deepseek_v4_internal.h coli_v4_expert_store.h coli_v4_residency.h coli_executor.h st.h
	$(CC) $(CFLAGS) -c coli_v4_expert_store_auto.c -o $@

$(V4_BINARY): $(V4_OBJS)
	$(CC) $(V4_OBJS) -o $@ $(LDFLAGS)

$(V4_AMALGAMATED_OBJS): %.o: deepseek_v4.c deepseek_v4.h \
	deepseek_v4_internal.h deepseek_v4_dspark.inc st.h json.h compat.h tensor.h quant.h \
	native_quant.h native_quant_batch.h native_quant_dual.h \
	native_quant_fp4_rows16.h
	$(CC) $(CFLAGS) -D$* -c deepseek_v4.c -o $@

deepseek-v4-test-objs: $(TEST_UNIT_OBJS)

deepseek-v4-clean:
	rm -f $(V4_BINARY) $(V4_OBJS) $(TEST_UNIT_OBJS) $(V4_BUILD_CONFIG)
