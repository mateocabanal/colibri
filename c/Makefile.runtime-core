CC ?= cc
CFLAGS ?= -O2 -std=c11 -Wall -Wextra -Werror
EXE :=
ifeq ($(OS),Windows_NT)
EXE := .exe
endif

.PHONY: check clean

check: test_record_io$(EXE) test_expert_residency$(EXE) test_expert_activation$(EXE) test_expert_residency_policy$(EXE) test_expert_resource_bridge$(EXE) test_resource_planner$(EXE) test_reuse_projection$(EXE) test_moe_adaptive_residency$(EXE)
	./test_record_io$(EXE)
	./test_expert_residency$(EXE)
	./test_expert_activation$(EXE)
	./test_expert_residency_policy$(EXE)
	./test_expert_resource_bridge$(EXE)
	./test_resource_planner$(EXE)
	./test_reuse_projection$(EXE)
	./test_moe_adaptive_residency$(EXE)

test_record_io$(EXE): tests/test_record_io.c record_io.h
	$(CC) $(CFLAGS) tests/test_record_io.c -o $@

test_expert_residency$(EXE): tests/test_expert_residency.c expert_residency.h expert_store.h
	$(CC) $(CFLAGS) tests/test_expert_residency.c -o $@

test_expert_activation$(EXE): tests/test_expert_activation.c expert_activation.h expert_store.h
	$(CC) $(CFLAGS) tests/test_expert_activation.c -o $@

test_expert_residency_policy$(EXE): tests/test_expert_residency_policy.c expert_residency_policy.h expert_activation.h expert_store.h resource_planner.h reuse_projection.h
	$(CC) $(CFLAGS) tests/test_expert_residency_policy.c -o $@

test_expert_resource_bridge$(EXE): tests/test_expert_resource_bridge.c expert_residency_policy.h expert_activation.h expert_store.h resource_planner.h reuse_projection.h
	$(CC) $(CFLAGS) tests/test_expert_resource_bridge.c -o $@

test_resource_planner$(EXE): tests/test_resource_planner.c resource_planner.h
	$(CC) $(CFLAGS) tests/test_resource_planner.c -o $@

test_reuse_projection$(EXE): tests/test_reuse_projection.c reuse_projection.h
	$(CC) $(CFLAGS) tests/test_reuse_projection.c -o $@

test_moe_adaptive_residency$(EXE): tests/test_moe_adaptive_residency.c moe_adaptive_residency.h expert_residency_policy.h expert_activation.h expert_store.h resource_planner.h reuse_projection.h
	$(CC) $(CFLAGS) tests/test_moe_adaptive_residency.c -o $@

clean:
	rm -f test_record_io test_record_io.exe test_expert_residency test_expert_residency.exe \
		test_expert_activation test_expert_activation.exe \
		test_expert_residency_policy test_expert_residency_policy.exe \
		test_expert_resource_bridge test_expert_resource_bridge.exe \
		test_resource_planner test_resource_planner.exe \
		test_reuse_projection test_reuse_projection.exe \
		test_moe_adaptive_residency test_moe_adaptive_residency.exe
