CC ?= cc
CFLAGS ?= -O2 -std=c11 -Wall -Wextra -Werror
EXE :=
ifeq ($(OS),Windows_NT)
EXE := .exe
endif

.PHONY: check clean

check: test_record_io$(EXE) test_expert_residency$(EXE) test_expert_activation$(EXE) test_expert_residency_policy$(EXE)
	./test_record_io$(EXE)
	./test_expert_residency$(EXE)
	./test_expert_activation$(EXE)
	./test_expert_residency_policy$(EXE)

test_record_io$(EXE): tests/test_record_io.c record_io.h
	$(CC) $(CFLAGS) tests/test_record_io.c -o $@

test_expert_residency$(EXE): tests/test_expert_residency.c expert_residency.h expert_store.h
	$(CC) $(CFLAGS) tests/test_expert_residency.c -o $@

test_expert_activation$(EXE): tests/test_expert_activation.c expert_activation.h expert_store.h
	$(CC) $(CFLAGS) tests/test_expert_activation.c -o $@

test_expert_residency_policy$(EXE): tests/test_expert_residency_policy.c expert_residency_policy.h expert_activation.h expert_store.h
	$(CC) $(CFLAGS) tests/test_expert_residency_policy.c -o $@

clean:
	rm -f test_record_io test_record_io.exe test_expert_residency test_expert_residency.exe \
		test_expert_activation test_expert_activation.exe \
		test_expert_residency_policy test_expert_residency_policy.exe