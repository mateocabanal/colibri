static inline int coli_prefix_disk_restore_longest(ColiPrefixDiskCache*c,const int*tokens,int n,ColiPrefixDiskHit*hit){if(hit)memset(hit,0,sizeof(*hit));if(!c||!c->enabled||!tokens||!hit||n<=1)return 0;c->lookups++;int floor=c->min_tokens>0?c->min_tokens:1;if(n-1<floor)return 0;uint64_t*hash=(uint64_t*)malloc((size_t)(n+1)*sizeof(uint64_t));if(!hash)return 0;hash[0]=PFX_FNV_OFFSET;for(int i=0;i<n;i++)hash[i+1]=token_hash_next(hash[i],tokens[i]);PrefixLock l;
#ifndef _WIN32
l.fd=-1;
#endif
if(!lock_acquire(c->directory,&l)){free(hash);return 0;}cleanup_temps(c->directory);(void)prune_for(c,0);for(int count=n-1;count>=floor;count--){char path[COLI_PREFIX_DISK_PATH_MAX];if(!object_path(c,count,hash[count],path,sizeof(path)))continue;struct stat st;if(stat(path,&st)!=0)continue;if(read_candidate(c,path,tokens,count,hash[count],hit)){c->hits++;if(c->log)fprintf(stderr,"[PREFIX-SSD] hit matched=%d prompt=%d bytes=%.2fMiB\n",count,n,(double)hit->payload_bytes/(1024.0*1024.0));lock_release(&l);free(hash);return count;}}lock_release(&l);free(hash);return 0;}
static inline void coli_prefix_disk_hit_free(ColiPrefixDiskHit*h){if(!h)return;free(h->tokens);free(h->payload);memset(h,0,sizeof(*h));}
static inline void coli_prefix_disk_stats(const ColiPrefixDiskCache*c,ColiPrefixDiskStats*s){if(!s)return;memset(s,0,sizeof(*s));if(!c)return;s->lookups=c->lookups;s->hits=c->hits;s->stores=c->stores;s->evictions=c->evictions;s->corruptions=c->corruptions;s->read_bytes=c->read_bytes;s->write_bytes=c->write_bytes;s->resident_bytes=c->resident_bytes;s->budget_bytes=c->budget_bytes;s->min_free_bytes=c->min_free_bytes;}
