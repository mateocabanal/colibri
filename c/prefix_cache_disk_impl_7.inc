PrefixDiskHeader h;memset(&h,0,sizeof(h));memcpy(h.magic,PFX_MAGIC,8);h.version=COLI_PREFIX_DISK_VERSION;h.header_bytes=(uint32_t)sizeof(h);h.endian=PFX_ENDIAN;h.engine_id=c->engine_id;h.state_abi=c->state_abi;h.token_count=(uint32_t)n;memcpy(h.model_fingerprint,c->model_fingerprint,32);h.layout_fingerprint=c->layout_fingerprint;h.token_hash=hash;h.payload_bytes=(uint64_t)payload_bytes;static uint64_t serial;unsigned long long seq=(unsigned long long)++serial;int w=snprintf(tmp_path,sizeof(tmp_path),"%s.tmp.%lu.%llu",final_path,(unsigned long)getpid(),seq);int ok=w>0&&(size_t)w<sizeof(tmp_path);FILE*fp=ok?fopen(tmp_path,"wb"):NULL;if(!fp)ok=0;if(ok&&fwrite(&h,1,sizeof(h),fp)!=sizeof(h))ok=0;if(ok&&fwrite(dt,1,token_bytes,fp)!=token_bytes)ok=0;WriteSink sink={fp,UINT32_MAX,0,payload_bytes,0};sink.crc=crc32c_update(sink.crc,dt,token_bytes);if(ok&&stream&&stream(user,stream_sink,&sink))ok=0;if(sink.failed||sink.written!=payload_bytes)ok=0;if(ok){h.payload_crc32c=~sink.crc;if(fseek(fp,0,SEEK_SET)!=0||fwrite(&h,1,sizeof(h),fp)!=sizeof(h))ok=0;}if(ok&&!sync_file(fp))ok=0;if(fp&&fclose(fp)!=0)ok=0;
