static int stream_sink(void*data,const void*src,size_t bytes){WriteSink*s=(WriteSink*)data;if(!s||s->failed||(bytes&&!src)||bytes>s->expected-s->written){if(s)s->failed=1;return -1;}if(bytes&&fwrite(src,1,bytes,s->fp)!=bytes){s->failed=1;return -1;}s->crc=crc32c_update(s->crc,src,bytes);s->written+=bytes;return 0;}
static inline int coli_prefix_disk_store_stream(ColiPrefixDiskCache*c,const int*tokens,int n,size_t payload_bytes,ColiPrefixDiskStreamFn stream,void*user){if(!c||!c->enabled||!tokens||n<c->min_tokens||n<=0||(payload_bytes&&!stream))return 0;if((size_t)n>(SIZE_MAX-sizeof(PrefixDiskHeader)-payload_bytes)/sizeof(int32_t))return 0;size_t token_bytes=(size_t)n*sizeof(int32_t),object_bytes=sizeof(PrefixDiskHeader)+token_bytes+payload_bytes;if(object_bytes>c->budget_bytes)return 0;int32_t*dt=(int32_t*)malloc(token_bytes);if(!dt)return 0;for(int i=0;i<n;i++)dt[i]=(int32_t)tokens[i];uint64_t hash=token_hash(tokens,n);char final_path[COLI_PREFIX_DISK_PATH_MAX],tmp_path[COLI_PREFIX_DISK_PATH_MAX];if(!object_path(c,n,hash,final_path,sizeof(final_path))){free(dt);return 0;}PrefixLock l;
