typedef struct{const ColiPrefixDiskPart*parts;size_t count;} PartStream;
static int emit_parts(void*user,ColiPrefixDiskSinkFn sink,void*sink_data){PartStream*p=(PartStream*)user;if(!p||!sink)return -1;for(size_t i=0;i<p->count;i++){if(p->parts[i].bytes&&!p->parts[i].data)return -1;if(sink(sink_data,p->parts[i].data,p->parts[i].bytes))return -1;}return 0;}
static inline int coli_prefix_disk_store_parts(ColiPrefixDiskCache*c,const int*t,int n,const ColiPrefixDiskPart*parts,size_t count){if(count&&!parts)return 0;size_t bytes=0;for(size_t i=0;i<count;i++){if(parts[i].bytes>SIZE_MAX-bytes)return 0;bytes+=parts[i].bytes;}PartStream p={parts,count};return coli_prefix_disk_store_stream(c,t,n,bytes,emit_parts,&p);}
static inline int coli_prefix_disk_store(ColiPrefixDiskCache*c,const int*t,int n,const void*p,size_t bytes){ColiPrefixDiskPart part={p,bytes};return coli_prefix_disk_store_parts(c,t,n,&part,1);}

static int read_candidate(ColiPrefixDiskCache*c,const char*path,const int*tokens,int n,uint64_t expected,ColiPrefixDiskHit*hit){FILE*fp=fopen(path,"rb");if(!fp)return 0;PrefixDiskHeader h;int valid=fread(&h,1,sizeof(h),fp)==sizeof(h)&&!memcmp(h.magic,PFX_MAGIC,8)&&h.version==COLI_PREFIX_DISK_VERSION&&h.header_bytes==sizeof(h)&&h.endian==PFX_ENDIAN&&h.engine_id==c->engine_id&&h.state_abi==c->state_abi&&h.token_count==(uint32_t)n&&!memcmp(h.model_fingerprint,c->model_fingerprint,32)&&h.layout_fingerprint==c->layout_fingerprint&&h.token_hash==expected&&h.payload_bytes<=SIZE_MAX&&h.payload_bytes<=c->budget_bytes;size_t token_bytes=(size_t)n*sizeof(int32_t);struct stat st;if(valid){uint64_t expect=(uint64_t)sizeof(h)+(uint64_t)token_bytes+h.payload_bytes;if(stat(path,&st)!=0||st.st_size<0||(uint64_t)st.st_size!=expect)valid=0;}int32_t*dt=NULL;unsigned char*payload=NULL;if(valid){dt=(int32_t*)malloc(token_bytes);payload=h.payload_bytes?(unsigned char*)malloc((size_t)h.payload_bytes):NULL;if(!dt||(h.payload_bytes&&!payload))valid=0;}if(valid&&fread(dt,1,token_bytes,fp)!=token_bytes)valid=0;if(valid)for(int i=0;i<n;i++)if(dt[i]!=(int32_t)tokens[i]){valid=0;break;}if(valid&&h.payload_bytes&&fread(payload,1,(size_t)h.payload_bytes,fp)!=(size_t)h.payload_bytes)valid=0;if(valid&&fgetc(fp)!=EOF)valid=0;fclose(fp);if(valid){uint32_t crc=UINT32_MAX;crc=crc32c_update(crc,dt,token_bytes);crc=crc32c_update(crc,payload,(size_t)h.payload_bytes);valid=(~crc)==h.payload_crc32c;}free(dt);if(!valid){free(payload);c->corruptions++;uint64_t bad=0;if(stat(path,&st)==0&&st.st_size>0)bad=(uint64_t)st.st_size;if(remove(path)==0)c->resident_bytes=bad<=c->resident_bytes?c->resident_bytes-bad:0;return 0;}hit->tokens=(int*)malloc((size_t)n*sizeof(int));if(!hit->tokens){free(payload);return 0;}memcpy(hit->tokens,tokens,(size_t)n*sizeof(int));hit->token_count=n;hit->payload=payload;hit->payload_bytes=(size_t)h.payload_bytes;c->read_bytes+=(uint64_t)(sizeof(h)+token_bytes+hit->payload_bytes);(void)utim